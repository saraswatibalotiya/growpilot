# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# JWT
JWT_ACCESS_SECRET="replace-with-at-least-32-random-bytes"

# Instagram (Instagram API with Instagram Login) -- read-only; publishing stays disabled
INSTAGRAM_MODE=mock                      # mock | live
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/integrations/instagram/callback
INSTAGRAM_GRAPH_VERSION=v23.0
INSTAGRAM_LIVE_ALLOWLIST=                # comma-separated IG ids/usernames allowed in live mode
INSTAGRAM_TOKEN_ENCRYPTION_KEY=          # openssl rand -base64 32
FRONTEND_URL=http://localhost:3000
ENABLE_LIVE_INSTAGRAM_PUBLISH=false

# Instagram media sync (BullMQ worker; live mode only)
INSTAGRAM_SYNC_WORKER=true               # false = API-only instance, does not consume sync jobs
INSTAGRAM_SYNC_MAX_PAGES=20              # media pages per run (50 posts per page)
INSTAGRAM_SYNC_INSIGHTS_LIMIT=25         # posts per run that get per-post insights calls
INSTAGRAM_SYNC_REQUEST_DELAY_MS=250      # pause between per-post insights calls

# AI (Claude). Model IDs are read here only. Change them without touching code.
ANTHROPIC_API_KEY=
# Google Cloud Text-to-Speech key for Reel voiceovers (Cloud TTS API enabled); empty = Reel generation fails with a clear message
GOOGLE_TTS_API_KEY=
CLAUDE_SONNET_MODEL=claude-sonnet-5          # content, editing and photo analysis. Newer option: claude-sonnet-5-5
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001 # intent, extraction, edit plans, summaries. Newer option: claude-haiku-5-5
# Optional tuning (defaults shown)
# AI_HAIKU_TIMEOUT_MS=20000
# AI_SONNET_TIMEOUT_MS=60000
# AI_MAX_RETRIES=2
# AI_TRUSTED_IMAGE_HOSTS=res.cloudinary.com    # photos for analysis must come from here AND be a shop upload

# Gemini image enhancement (optional). Empty key = off; Sharp/template generation stays the default.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_PREMIUM_MODEL=gemini-3.1-flash-image
# Per business per UTC day; failed/rejected attempts count. 0 disables Gemini.
GEMINI_DAILY_LIMIT_PER_BUSINESS=10
# Estimated cost recorded for usage tracking (USD per image)
# GEMINI_COST_PER_IMAGE_USD=0.02
# GEMINI_PREMIUM_COST_PER_IMAGE_USD=0.04
# GEMINI_TIMEOUT_MS=90000

# Reels: FFmpeg light sweeps + floating particles (free). Set false for the original look.
REEL_MOTION_EFFECTS=true
