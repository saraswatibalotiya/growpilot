# Copy to backend/.env; replace placeholders locally. Never commit secrets.
# Root Compose uses growpilot_user / growpilot_db. Match its configured password.
# Percent-encode reserved characters in URL credentials.
DATABASE_URL=postgresql://growpilot_user:<compose-password>@localhost:5432/growpilot_db
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# Generate at least 32 random bytes, e.g. openssl rand -hex 32.
JWT_ACCESS_SECRET=<replace-with-random-secret>
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# JWT_SECRET is a legacy fallback; prefer JWT_ACCESS_SECRET, not both.

# Instagram OAuth/sync. Mock mode and publishing-off are normal local defaults.
# Live credentials come from your Meta developer app. The callback must match it.
INSTAGRAM_MODE=mock
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/integrations/instagram/callback
INSTAGRAM_GRAPH_VERSION=v23.0
INSTAGRAM_LIVE_ALLOWLIST=
# Required for stored-token encryption: openssl rand -base64 32
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
ENABLE_LIVE_INSTAGRAM_PUBLISH=false
ENABLE_TEST_MODE=false
# Optional Facebook Login selection (otherwise Instagram Login):
# INSTAGRAM_LOGIN_CONFIG_ID=
# META_APP_ID, META_APP_SECRET and META_REDIRECT_URI are compatibility fallbacks.
# Prefer the INSTAGRAM_* variables; do not populate both sets unnecessarily.

# Redis powers sync jobs and OAuth nonce storage.
# The worker connects even in mock mode; false disables job consumption.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
INSTAGRAM_SYNC_WORKER=true
INSTAGRAM_SYNC_MAX_PAGES=20
INSTAGRAM_SYNC_INSIGHTS_LIMIT=25
INSTAGRAM_SYNC_REQUEST_DELAY_MS=250

# Cloudinary storage credentials: obtain from your Cloudinary dashboard.
# Uploads/storage operations need these even when Instagram is mocked.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# NestJS Claude content/intent features. Obtain a server key from Anthropic.
# Verify model availability for your account; defaults are not entitlements.
ANTHROPIC_API_KEY=
CLAUDE_SONNET_MODEL=claude-sonnet-5
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001
# AI_HAIKU_TIMEOUT_MS=20000
# AI_SONNET_TIMEOUT_MS=60000
# AI_MAX_RETRIES=2
# AI_TRUSTED_IMAGE_HOSTS=res.cloudinary.com

# NestJS Gemini images (optional). Obtain a server key from Google AI Studio.
# Empty key disables Gemini; Sharp templates remain, but storage is still needed.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
GEMINI_IMAGE_PREMIUM_MODEL=gemini-3.1-flash-image
# Per business per UTC day; failed/rejected attempts count. 0 disables Gemini.
GEMINI_DAILY_LIMIT_PER_BUSINESS=10
# Estimated tracking costs, not confirmed vendor billing:
# GEMINI_COST_PER_IMAGE_USD=0.02
# GEMINI_PREMIUM_COST_PER_IMAGE_USD=0.04
# GEMINI_TIMEOUT_MS=90000
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional private Python service. Never expose its URL/token to the browser.
AI_ENGINE_ENABLED=false
# AI_ENGINE_URL=http://127.0.0.1:8001
# AI_ENGINE_SERVICE_TOKEN=<match-python-SERVICE_TOKEN>
# AI_ENGINE_TIMEOUT_MS=15000
# AI_ENGINE_GENERATE_TIMEOUT_MS=60000
# AI_ENGINE_MAX_RETRIES=2
# AI_ENGINE_BREAKER_THRESHOLD=5
# AI_ENGINE_BREAKER_COOLDOWN_MS=30000
# AI_ENGINE_MAX_POSTS=200

# Historical GOOGLE_TTS_API_KEY / REEL_MOTION_EFFECTS are not consumed.
# Current reels use image scenes and ffmpeg-static, with no voiceover stage.
