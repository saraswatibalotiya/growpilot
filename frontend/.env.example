# Browser API base. Development defaults to /api through the Vite proxy.
# For a different production API origin, set this before building.
# VITE_API_BASE=/api

# Enable only after backend publishing and the real Instagram account are configured.
# This UI flag does not bypass backend approval or publishing gates.
VITE_FEATURE_PUBLISHING=false

# The development proxy target is read from the Vite process environment.
# To override the default http://localhost:4000, launch with:
# VITE_API_PROXY_TARGET=http://localhost:4000 npm run dev

# VITE_* values are public browser configuration. Never put API keys,
# Instagram credentials, JWT secrets or the AI-engine service token here.
