# Where the dev server proxies /api to (the backend). Defaults to http://localhost:4000.
# VITE_API_PROXY_TARGET=http://localhost:4000

# Override only if the API is served from another origin. Defaults to /api (proxied in development).
# VITE_API_BASE=/api

# Turn these on when the backend ships the endpoints. While off, the UI uses clearly labelled demo content
# for AI text and refuses to publish, rather than pretending.
VITE_FEATURE_AI=false
VITE_FEATURE_PUBLISHING=false
