# Copy to .env (git-ignored) and start the application from ai-engine/.
# PostgreSQL is required for application data. The mock wording provider needs no paid API key.
# Production requires SERVICE_TOKEN and explicit real-data configuration.

ENVIRONMENT=development          # development | test | production (production REQUIRES SERVICE_TOKEN)
LOG_LEVEL=INFO

# AI provider: mock (default, no key) | gemini | claude
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5     # repository default; verify availability and override for your account
AI_TIMEOUT_SECONDS=30
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=2048

# HTTP
CORS_ORIGINS=                    # comma-separated, empty = none
MAX_BODY_BYTES=2000000
RATE_LIMIT_PER_MINUTE=300        # per caller; 0 = off
SERVICE_TOKEN=                   # shared secret for service-to-service calls

# Data and analysis
LOAD_MOCK_DATA=false             # optional bundled fixtures; dashboard mock previews persist separately
DEFAULT_TIMEZONE=Asia/Kolkata
MIN_POSTS_FOR_BASELINE=5
MIN_POSTS_PER_FORMAT=3
MIN_POSTS_FOR_TIMING=12
MIN_COMMENTS_FOR_AUDIENCE=10
TREND_MAX_AGE_DAYS=14
MIN_LEARNING_SAMPLES=3

# Opportunity-score weights (normalised over the signals that are available).
# ScoreWeights reads process environment separately: export overrides before startup.
WEIGHT_HISTORICAL=0.25
WEIGHT_AUDIENCE=0.20
WEIGHT_TREND=0.20
WEIGHT_FESTIVAL=0.15
WEIGHT_COMPETITOR=0.10
WEIGHT_GOAL=0.10

# Storage: PostgreSQL is mandatory outside automated tests.
STORAGE_BACKEND=postgres
# Shared GrowPilot database; AI tables live in the ai_engine schema, backend tables in public.
# Alembic does not load this file: also export DATABASE_URL before migration commands.
DATABASE_URL=postgresql+asyncpg://growpilot_user:growpilot_password@localhost:5432/growpilot_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_COMMAND_TIMEOUT_SECONDS=30

# Trends and festivals (defaults include FICTIONAL / approximate samples).
# For real intelligence: TREND_PROVIDER=none or file, FESTIVAL_INCLUDE_SAMPLE=false.
TREND_PROVIDER=sample            # sample | file | none
TREND_DATA_FILE=                 # required when TREND_PROVIDER=file
FESTIVAL_DATA_FILE=              # optional verified festival calendar (JSON)
FESTIVAL_INCLUDE_BUNDLED_VERIFIED=true   # curated 2027 DoPT records; jurisdiction and date caveats apply
FESTIVAL_INCLUDE_SAMPLE=true     # false hides the bundled approximate festival dates

# Docker Compose uses the root PostgreSQL service, not a separate AI database.
# SERVICE_TOKEN must match the backend AI_ENGINE_SERVICE_TOKEN when authentication is configured.

# Optional test controls: tests read these from exported process environment.
# WARNING: persistence tests truncate engine tables in the selected TEST database.
# TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/growpilot_test
# LIVE_AI_TESTS=1

# Destructive migration controls: intentionally unset. Use only after backup
# and explicit authorization to downgrade the exact named database.
# AI_ENGINE_ALLOW_DESTRUCTIVE_MIGRATION=yes
# AI_ENGINE_CONFIRM_DATABASE=<exact-ai-database-name>
